# ==============================================================================
# GHOSTSHIELD: Environment Configuration Template
# Copy to .env.local to customize local behavior
# Demo mode runs with ZERO credentials by default
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Engine Mode Selection
# Options: 'demo' (zero-dependency in-memory graph) | 'tigergraph' (live GSQL)
# ------------------------------------------------------------------------------
GHOSTSHIELD_ENGINE_MODE=demo

# ------------------------------------------------------------------------------
# 2. TigerGraph Cloud Configuration (Required only when GHOSTSHIELD_ENGINE_MODE=tigergraph)
# ------------------------------------------------------------------------------
TIGERGRAPH_HOST=https://your-cluster.i.tgcloud.io
TIGERGRAPH_GRAPH_NAME=GhostShieldGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your_tigergraph_password
# Optional: Secret token generated via GraphStudio
# TIGERGRAPH_SECRET=your_graph_secret_here
# Optional: Direct Bearer Token
# TIGERGRAPH_TOKEN=your_token_here
TIGERGRAPH_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 3. AI Grants India (AIGI) / LLM Narrative Synthesis (Optional)
# If left empty, GhostShield uses deterministic zero-hallucination templates
# ------------------------------------------------------------------------------
# AIGI_API_KEY=your_aigi_api_key_here
# AIGI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
# AIGI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. viaSocket Real-Time Incident Webhook Alerts (Optional)
# If left empty, alerts are reported as UNCONFIGURED without failure
# ------------------------------------------------------------------------------
# VIASOCKET_WEBHOOK_URL=https://flow.viasocket.com/your-workflow-webhook
# VIASOCKET_TIMEOUT_MS=4000
