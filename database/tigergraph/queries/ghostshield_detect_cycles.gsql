// ==============================================================================
// GSQL Query B: ghostshield_detect_cycles
// Pure GSQL v1 standard hop-by-hop cycle detection
// ==============================================================================

USE GRAPH GhostShieldGraph

CREATE OR REPLACE QUERY ghostshield_detect_cycles(
    INT time_window_seconds = 600,
    INT max_depth = 4,
    INT result_limit = 50
) FOR GRAPH GhostShieldGraph {
    TYPEDEF TUPLE<
        STRING cycle_path,
        INT hop_count,
        INT start_time,
        INT end_time,
        INT duration_seconds,
        DOUBLE min_amount,
        DOUBLE max_amount,
        DOUBLE volume_retention,
        BOOL temporally_valid,
        STRING risk_level
    > CycleRecord;

    ListAccum<CycleRecord> @@detected_cycles;
    MapAccum<VERTEX<Wallet>, INT> @start_times;

    // Hop 1: Wallet -> Counterparty
    H1 = SELECT tgt FROM Wallet:src -(TRANSFERRED_TO:e)-> Wallet:tgt
         ACCUM tgt.@start_times += (src -> e.event_timestamp);

    // Hop 2: Counterparty -> Intermediate
    H2 = SELECT tgt FROM H1:src -(TRANSFERRED_TO:e)-> Wallet:tgt;

    // Hop 3: Intermediate -> Original Sender (Cycle completed)
    H3 = SELECT tgt FROM H2:src -(TRANSFERRED_TO:e)-> Wallet:tgt
         ACCUM
             IF tgt.@start_times.containsKey(tgt) THEN
                 @@detected_cycles += CycleRecord(
                     tgt.label + " -> " + src.label + " -> " + tgt.label,
                     3,
                     tgt.@start_times.get(tgt),
                     e.event_timestamp,
                     abs(e.event_timestamp - tgt.@start_times.get(tgt)),
                     e.amount,
                     e.amount,
                     1.0,
                     TRUE,
                     "HIGH"
                 )
             END
         LIMIT result_limit;

    PRINT @@detected_cycles AS cycles,
          @@detected_cycles.size() AS total_cycles_found;
}
