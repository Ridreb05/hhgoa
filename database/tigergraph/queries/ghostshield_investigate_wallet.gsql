// ==============================================================================
// GSQL Query C: ghostshield_investigate_wallet
// Pure GSQL v1 multi-hop wallet investigation
// ==============================================================================

USE GRAPH GhostShieldGraph

CREATE OR REPLACE QUERY ghostshield_investigate_wallet(
    VERTEX<Wallet> target_wallet,
    INT max_hops = 2,
    INT transfer_limit = 25,
    INT neighbor_limit = 50
) FOR GRAPH GhostShieldGraph {
    TYPEDEF TUPLE<STRING from_id, STRING to_id, DOUBLE amount, STRING asset, INT event_timestamp, STRING tx_id, STRING direction> TransferRecord;
    TYPEDEF TUPLE<STRING source_id, STRING category, STRING label, DOUBLE amount, INT funding_timestamp, STRING event_id> FundingRecord;
    TYPEDEF TUPLE<STRING agent_id, STRING display_name, STRING agent_type, STRING delegation_partner_id, STRING delegation_type> AgentRecord;
    TYPEDEF TUPLE<STRING contract_id, STRING protocol, STRING category, STRING interaction_type, INT interaction_timestamp> ContractRecord;
    TYPEDEF TUPLE<STRING entity_id, STRING entity_type, INT hop_distance, STRING reason> RiskSeedRecord;

    ListAccum<TransferRecord> @@transfers;
    ListAccum<FundingRecord> @@funding_sources;
    ListAccum<AgentRecord> @@agents;
    ListAccum<ContractRecord> @@contracts;
    ListAccum<RiskSeedRecord> @@risk_seeds_nearby;
    SetAccum<STRING> @@shared_funding_wallets;

    Start = { target_wallet };

    // 1. Direct Outgoing Transfers
    OutTx = SELECT tgt FROM Start:src -(TRANSFERRED_TO:e)-> Wallet:tgt
            ACCUM @@transfers += TransferRecord(src.label, tgt.label, e.amount, e.asset, e.event_timestamp, e.tx_id, "OUTGOING")
            LIMIT transfer_limit;

    // 2. Direct Incoming Transfers
    InTx = SELECT src FROM Start:tgt -(REVERSE_TRANSFERRED_TO:e)-> Wallet:src
           ACCUM @@transfers += TransferRecord(src.label, tgt.label, e.amount, e.asset, e.event_timestamp, e.tx_id, "INCOMING")
           LIMIT transfer_limit;

    // 3. Direct Upstream Funding Sources
    Funding = SELECT fs FROM Start:tgt -(FUNDED_BY:e)-> FundingSource:fs
              ACCUM @@funding_sources += FundingRecord(fs.label, fs.category, fs.label, e.amount, e.funding_timestamp, e.tx_id);

    // 4. Shared Funding Counterparties
    SharedWallets = SELECT w FROM Funding:fs -(FUNDED:e)-> Wallet:w
                    WHERE w != target_wallet
                    ACCUM @@shared_funding_wallets += w.label
                    LIMIT neighbor_limit;

    // 5. Associated Controlling Agents
    Agents = SELECT a FROM Start:tgt -(CONTROLLED_BY:e)-> Agent:a
             ACCUM @@agents += AgentRecord(a.display_name, a.display_name, a.agent_type, "", "");

    // 6. Connected Smart Contracts
    Contracts = SELECT sc FROM Start:w -(INTERACTS_WITH:e)-> SmartContract:sc
                ACCUM @@contracts += ContractRecord(sc.protocol, sc.protocol, sc.category, e.method, e.interaction_timestamp)
                LIMIT neighbor_limit;

    // 7. Known-Risk Proximity (Two separate 1-hop queries in standard GSQL v1)
    OutRisk = SELECT w FROM Start:src -(TRANSFERRED_TO:e)-> Wallet:w
              WHERE w.is_risk_seed
              ACCUM @@risk_seeds_nearby += RiskSeedRecord(w.label, "Wallet", 1, "Direct transfer counterparty with risk seed");

    InRisk = SELECT w FROM Start:src -(REVERSE_TRANSFERRED_TO:e)-> Wallet:w
             WHERE w.is_risk_seed
             ACCUM @@risk_seeds_nearby += RiskSeedRecord(w.label, "Wallet", 1, "Direct transfer counterparty with risk seed");

    PRINT target_wallet.label AS investigated_wallet_id,
          target_wallet.label AS wallet_label,
          target_wallet.is_risk_seed AS is_target_risk_seed,
          @@transfers AS transfers,
          @@funding_sources AS direct_funding_sources,
          @@shared_funding_wallets AS shared_funding_peer_wallets,
          @@agents AS controlling_agents,
          @@contracts AS contract_interactions,
          @@risk_seeds_nearby AS risk_seed_connections;
}
