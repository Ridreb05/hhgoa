// ==============================================================================
// GSQL Query E: ghostshield_sybil_clusters
// Coordinated-wallet community detection (weakly connected components, min-label
// propagation) over two kinds of coordination evidence:
//   1. CONTROL   wallets controlled by the same agent, if that agent controls at
//                most agent_hub_cap wallets (larger agents are legitimate
//                fleets, e.g. market makers, and are pruned as hubs)
//   2. BURST     >= burst_min wallets funded by the same source inside one
//                burst_seconds bucket, if that source funds at most
//                funder_hub_cap wallets overall (coordinated funding, not mere
//                exchange membership: a funder with thousands of customers
//                produces chance bursts by volume alone). ignore_funder_category
//                additionally drops a whole funder category (e.g. "EXCHANGE"): on real
//                Ethereum traffic every burst cluster found was an exchange provisioning
//                deposit addresses, which is structurally identical to a sybil funder.
// Mega-funders (exchanges funding thousands of users) never link wallets on
// their own, which is what keeps precision high. Everything runs in-engine.
// Optionally writes Wallet.community_id.
// ==============================================================================

USE GRAPH GhostShieldGraph

CREATE OR REPLACE QUERY ghostshield_sybil_clusters(
    INT min_cluster_size = 5,
    INT result_limit = 50,
    INT agent_hub_cap = 100,
    INT funder_hub_cap = 500,
    STRING ignore_funder_category = "",
    INT burst_min = 5,
    INT burst_seconds = 7200,
    INT max_iter = 8,
    BOOL write_back = FALSE,
    STRING scope = ""
) FOR GRAPH GhostShieldGraph {
    TYPEDEF TUPLE<
        STRING root_entity_id,
        STRING root_type,
        STRING root_label,
        STRING category,
        INT member_count,
        STRING member_wallets,
        DOUBLE total_cluster_volume,
        STRING risk_level
    > SybilClusterRecord;

    MinAccum<STRING> @cid;
    MinAccum<STRING> @agent_min;
    MinAccum<STRING> @old;
    OrAccum @linked;
    OrAccum @agent_controlled;
    OrAccum @mixer_funded;
    SumAccum<DOUBLE> @out_volume;
    MapAccum<STRING, SumAccum<INT>> @@burst_size;
    SetAccum<STRING> @@qualified;
    MapAccum<STRING, MinAccum<STRING>> @@burst_min_cid;
    MapAccum<STRING, ListAccum<STRING>> @@members;
    MapAccum<STRING, SumAccum<DOUBLE>> @@volume;
    MapAccum<STRING, SumAccum<INT>> @@agent_members;
    MapAccum<STRING, SumAccum<INT>> @@mixer_members;
    ListAccum<SybilClusterRecord> @@clusters;
    SumAccum<INT> @@clusters_total;

    All = SELECT w FROM Wallet:w
          POST-ACCUM w.@cid = w.id;

    // Size of every (funder, time bucket) burst.
    Fb = SELECT w FROM FundingSource:f -(FUNDED>:e)- Wallet:w
         WHERE f.outdegree("FUNDED") <= funder_hub_cap AND f.category != ignore_funder_category
         ACCUM @@burst_size += (f.id + ":" + to_string(e.funding_timestamp / burst_seconds) -> 1);

    // Evidence flags + outflow for explainability.
    Fl = SELECT w FROM FundingSource:f -(FUNDED>:e)- Wallet:w
         ACCUM CASE WHEN f.category == "MIXER" THEN w.@mixer_funded += TRUE END;
    Ag = SELECT w FROM Agent:a -(CONTROLS>:e)- Wallet:w
         WHERE a.outdegree("CONTROLS") <= agent_hub_cap
         ACCUM w.@agent_controlled += TRUE;
    Vol = SELECT s FROM Wallet:s -(TRANSFERRED_TO>:e)- Wallet:t
          ACCUM s.@out_volume += e.amount;

    INT iter = 0;
    Changed = All;
    WHILE Changed.size() > 0 LIMIT max_iter DO
        iter = iter + 1;
        @@burst_min_cid.clear();
        Snap = SELECT w FROM Wallet:w POST-ACCUM w.@old = w.@cid;

        // Push current labels into agent hubs and burst buckets.
        A1 = SELECT a FROM Agent:a -(CONTROLS>:e)- Wallet:w
             WHERE a.outdegree("CONTROLS") <= agent_hub_cap
             ACCUM a.@agent_min += w.@cid;
        B1 = SELECT w FROM FundingSource:f -(FUNDED>:e)- Wallet:w
             WHERE f.outdegree("FUNDED") <= funder_hub_cap AND f.category != ignore_funder_category AND @@burst_size.get(f.id + ":" + to_string(e.funding_timestamp / burst_seconds)) >= burst_min
             ACCUM @@burst_min_cid += (f.id + ":" + to_string(e.funding_timestamp / burst_seconds) -> w.@cid);

        // Pull the smallest label back to wallets; track which wallets moved.
        P1 = SELECT w FROM Agent:a -(CONTROLS>:e)- Wallet:w
             WHERE a.outdegree("CONTROLS") <= agent_hub_cap
             ACCUM w.@cid += a.@agent_min, w.@linked += TRUE;
        P2 = SELECT w FROM FundingSource:f -(FUNDED>:e)- Wallet:w
             WHERE f.outdegree("FUNDED") <= funder_hub_cap AND f.category != ignore_funder_category AND @@burst_size.get(f.id + ":" + to_string(e.funding_timestamp / burst_seconds)) >= burst_min
             ACCUM w.@cid += @@burst_min_cid.get(f.id + ":" + to_string(e.funding_timestamp / burst_seconds)), w.@linked += TRUE;

        Changed = SELECT w FROM Wallet:w WHERE w.@cid != w.@old;
    END;

    Linked = SELECT w FROM Wallet:w
             WHERE w.@linked AND (scope == "" OR instr(w.provenance, scope) == 0)
             ACCUM @@members += (w.@cid -> w.id),
                   @@volume += (w.@cid -> w.@out_volume),
                   CASE WHEN w.@agent_controlled THEN @@agent_members += (w.@cid -> 1) END,
                   CASE WHEN w.@mixer_funded THEN @@mixer_members += (w.@cid -> 1) END;

    FOREACH (root, ids) IN @@members DO
        IF ids.size() >= min_cluster_size THEN
            @@clusters_total += 1;
            @@qualified += root;
            IF @@clusters.size() < result_limit THEN
                STRING joined = "";
                INT shown = 0;
                FOREACH m IN ids DO
                    IF shown < 40 THEN
                        joined = joined + m + ",";
                        shown = shown + 1;
                    END;
                END;
                @@clusters += SybilClusterRecord(
                    root,
                    "Community",
                    "Coordinated cluster " + root,
                    CASE WHEN @@agent_members.get(root) > 0 AND @@mixer_members.get(root) > 0 THEN "AGENT_AND_MIXER"
                         WHEN @@agent_members.get(root) > 0 THEN "AGENT_CONTROLLED"
                         WHEN @@mixer_members.get(root) > 0 THEN "MIXER_FUNDED"
                         ELSE "COORDINATED_FUNDING" END,
                    ids.size(),
                    joined,
                    @@volume.get(root),
                    CASE WHEN @@agent_members.get(root) > 0 AND @@mixer_members.get(root) > 0 THEN "CRITICAL"
                         WHEN @@agent_members.get(root) > 0 THEN "HIGH_COORDINATION"
                         ELSE "MEDIUM" END
                );
            END;
        END;
    END;

    IF write_back THEN
        Tag = SELECT w FROM Wallet:w
              WHERE w.@linked AND w.@cid IN @@qualified
              POST-ACCUM w.community_id = w.@cid;
    END;

    PRINT @@clusters AS sybil_clusters,
          @@clusters_total AS total_clusters_identified;
}
