// ==============================================================================
// GHOSTSHIELD: Master TigerGraph Graph & Query Setup Script
// Executes complete schema definition and query compilation
// Run via: gsql -u <username> -p <password> database/tigergraph/setup_graph.gsql
// ==============================================================================

// 1. Drop existing graph and schema if recreating
DROP GRAPH GhostShieldGraph
DROP TYPE Wallet
DROP TYPE FundingSource
DROP TYPE Agent
DROP TYPE SmartContract
DROP TYPE TRANSFERRED_TO
DROP TYPE REVERSE_TRANSFERRED_TO
DROP TYPE FUNDED
DROP TYPE FUNDED_BY
DROP TYPE CONTROLS
DROP TYPE CONTROLLED_BY
DROP TYPE DELEGATES_TO
DROP TYPE DELEGATED_FROM
DROP TYPE INTERACTS_WITH
DROP TYPE INTERACTED_BY

// 2. Define Schema
@database/tigergraph/schema.gsql

// 3. Define and Install Queries
@database/tigergraph/queries/ghostshield_dashboard_metrics.gsql
@database/tigergraph/queries/ghostshield_detect_cycles.gsql
@database/tigergraph/queries/ghostshield_investigate_wallet.gsql
@database/tigergraph/queries/ghostshield_risk_evidence.gsql
@database/tigergraph/queries/ghostshield_sybil_clusters.gsql
@database/tigergraph/queries/ghostshield_path_find.gsql

INSTALL QUERY ALL
