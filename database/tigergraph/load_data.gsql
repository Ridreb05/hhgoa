// ==============================================================================
// GHOSTSHIELD: Data Loading Job Definition
// Loads synthetic demo dataset into TigerGraph from CSV files
// Run via: gsql -g GhostShieldGraph database/tigergraph/load_data.gsql
// ==============================================================================

USE GRAPH GhostShieldGraph

CREATE LOADING JOB load_ghostshield_demo FOR GRAPH GhostShieldGraph {
    // Vertex CSV files
    DEFINE FILENAME f_wallets = "./data/demo/csv/wallets.csv";
    DEFINE FILENAME f_funding_sources = "./data/demo/csv/funding_sources.csv";
    DEFINE FILENAME f_agents = "./data/demo/csv/agents.csv";
    DEFINE FILENAME f_contracts = "./data/demo/csv/contracts.csv";

    // Edge CSV files
    DEFINE FILENAME f_transfers = "./data/demo/csv/transfers.csv";
    DEFINE FILENAME f_funding_edges = "./data/demo/csv/funding_edges.csv";
    DEFINE FILENAME f_control_edges = "./data/demo/csv/control_edges.csv";
    DEFINE FILENAME f_delegation_edges = "./data/demo/csv/delegation_edges.csv";
    DEFINE FILENAME f_interactions = "./data/demo/csv/interactions.csv";

    // Map Vertices
    LOAD f_wallets TO VERTEX Wallet VALUES($0, $1, $2, $3, $4, $5) USING HEADER="true", SEPARATOR=",";
    LOAD f_funding_sources TO VERTEX FundingSource VALUES($0, $1, $2, $3) USING HEADER="true", SEPARATOR=",";
    LOAD f_agents TO VERTEX Agent VALUES($0, $1, $2, $3) USING HEADER="true", SEPARATOR=",";
    LOAD f_contracts TO VERTEX SmartContract VALUES($0, $1, $2, $3) USING HEADER="true", SEPARATOR=",";

    // Map Edges
    LOAD f_transfers TO EDGE TRANSFERRED_TO VALUES($0, $1, $2, $3, $4, $5) USING HEADER="true", SEPARATOR=",";
    LOAD f_funding_edges TO EDGE FUNDED VALUES($0, $1, $2, $3, $4) USING HEADER="true", SEPARATOR=",";
    LOAD f_control_edges TO EDGE CONTROLS VALUES($0, $1, $2, $3) USING HEADER="true", SEPARATOR=",";
    LOAD f_delegation_edges TO EDGE DELEGATES_TO VALUES($0, $1, $2, $3) USING HEADER="true", SEPARATOR=",";
    LOAD f_interactions TO EDGE INTERACTS_WITH VALUES($0, $1, $2, $3, $4) USING HEADER="true", SEPARATOR=",";
}

RUN LOADING JOB load_ghostshield_demo
